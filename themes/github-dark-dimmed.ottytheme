[meta]
name        = "GitHub Dark Dimmed"
author      = "Based on GitHub's VS Code theme (Primer)"
mode        = "dark"
description = "GitHub Dark Dimmed, ported from the official GitHub VS Code theme (v6.3.5)."

# Every colour is taken verbatim from GitHub's official VS Code theme,
# "GitHub Dark Dimmed" (github-vscode-theme 6.3.5, themes/dark-dimmed.json).
# The VS Code key each value comes from is noted alongside it.

[terminal]
foreground           = "#ADBAC7"   # terminal.foreground
background           = "#22272E"   # editor.background
cursor               = "#539BF5"   # editorCursor.foreground
cursor-text          = "#22272E"
selection-foreground = "#ADBAC7"   # terminal.foreground
selection-background = "#264F78"   # VS Code default (theme leaves it unset)
# palette: terminal.ansiBlack … ansiWhite, then ansiBrightBlack … ansiBrightWhite
palette = [
    "#545D68", "#F47067", "#57AB5A", "#C69026",
    "#539BF5", "#B083F0", "#39C5CF", "#909DAB",
    "#636E7B", "#FF938A", "#6BC46D", "#DAAA3F",
    "#6CB6FF", "#DCBDFB", "#56D4DD", "#CDD9E5",
]

[cursor.bar]
color = "#539BF5"

[cursor.underline]
color = "#539BF5"

[token]
foreground = "#ADBAC7"   # foreground
secondary  = "#768390"   # descriptionForeground
tertiary   = "#636E7B"   # terminal.ansiBrightBlack
accent     = "#539BF5"   # textLink.foreground
success    = "#57AB5A"   # terminal.ansiGreen
warning    = "#C69026"   # terminal.ansiYellow
danger     = "#E5534B"   # errorForeground
hover-bg   = "#636E7B1A" # list.hoverBackground
active-bg  = "#636E7B66" # list.activeSelectionBackground
radius     = 6

[panel]
background = "#22272E"   # editor.background
surface    = "#2D333B"   # editorWidget.background
border     = "#444C56"   # panel.border

[window]
background = "#22272E"
material   = "none"

[titlebar]
background  = "#22272E"  # titleBar.activeBackground
foreground  = "#768390"  # titleBar.activeForeground
font-weight = 500

[titlebar.unfocused]
background = "#1C2128"   # titleBar.inactiveBackground
foreground = "#768390"   # titleBar.inactiveForeground

# Session list = VS Code's Explorer list + Activity Bar indicator.
[sidebar]
background   = "#1C2128"           # sideBar.background
border-right = "1px solid #444C56" # sideBar.border
material     = "none"

[tab]
radius      = 6
foreground  = "#768390"            # activityBar.inactiveForeground
font-weight = 400

[tab.hover]
background = "#636E7B1A"           # list.hoverBackground
foreground = "#ADBAC7"             # list.hoverForeground

[tab.active]
background      = "#636E7B66"      # list.activeSelectionBackground
foreground      = "#ADBAC7"        # list.activeSelectionForeground
font-weight     = 600
indicator       = "bar"
indicator-color = "#EC775C"        # activityBar.activeBorder

[tab.active.unfocused]
background      = "#636E7B66"      # list.inactiveSelectionBackground
foreground      = "#ADBAC7"        # list.inactiveSelectionForeground
indicator-color = "#444C56"        # tab.unfocusedActiveBorderTop

# Top/bottom tab strip = VS Code's editor tabs.
[tab-bar]
background    = "#1C2128"           # editorGroupHeader.tabsBackground
border-bottom = "1px solid #444C56" # editorGroupHeader.tabsBorder

[tab-bar.tab]
background = "#1C2128"             # tab.inactiveBackground
foreground = "#768390"             # tab.inactiveForeground
border     = "1px solid #444C56"   # tab.border

[tab-bar.tab.hover]
background = "#22272E"             # tab.hoverBackground

[tab-bar.tab.active]
background      = "#22272E"        # tab.activeBackground
foreground      = "#ADBAC7"        # tab.activeForeground
indicator-color = "#EC775C"        # tab.activeBorderTop

[container]
background = "#22272E"             # editor.background
radius     = 0

[divider]
color = "#444C56"                  # editorGroup.border
width = 1
